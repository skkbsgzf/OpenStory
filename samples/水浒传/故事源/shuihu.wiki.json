  "chapterSummaries": [
    {
      "chapter": 1,
      "title": "误走妖魔",
      "summary": "嘉祐三年京师瘟疫，范仲淹奏请天师，洪信赴龙虎山误放一百单八魔君。",
      "function": "建立",
      "emotion": "疑",
      "beats": 4
    },
    {
      "chapter": 2,
      "title": "王进私走",
      "summary": "高俅追拿旧怨，王进私走延安，史家村收史进为徒；史进烧庄上华山。",
      "function": "引人物",
      "emotion": "迫",
      "beats": 4
    },
    {
      "chapter": 3,
      "title": "拳打镇关西",
      "summary": "史进遇鲁达，鲁达为金氏父女出头三拳打死郑屠，逃亡五台山。",
      "function": "立好汉",
      "emotion": "怒",
      "beats": 4
    },
    {
      "chapter": 4,
      "title": "大闹五台山",
      "summary": "鲁达剃度智深，醉闹山门，长老荐往东京。",
      "function": "转场",
      "emotion": "豪",
      "beats": 3
    },
    {
      "chapter": 5,
      "title": "倒拔垂杨柳",
      "summary": "智深降服菜园泼皮，倒拔绿杨，结识林冲；高衙内调戏林妻。",
      "function": "接主线",
      "emotion": "义",
      "beats": 4
    },
    {
      "chapter": 6,
      "title": "误入白虎堂",
      "summary": "高俅使陆谦诱林冲带刀入白虎节堂，刺配沧州，智深野猪林相救。",
      "function": "加害",
      "emotion": "冤",
      "beats": 4
    },
    {
      "chapter": 7,
      "title": "风雪山神庙",
      "summary": "陆谦火烧草料场，林冲山神庙听得阴谋，杀三人冒雪投梁山。",
      "function": "爆发",
      "emotion": "烈",
      "beats": 4
    },
    {
      "chapter": 8,
      "title": "智取生辰纲",
      "summary": "林冲纳投名状；杨志押纲，吴用设计于黄泥冈以蒙汗药劫走生辰纲。",
      "function": "聚义",
      "emotion": "谋",
      "beats": 4
    },
    {
      "chapter": 9,
      "title": "火并王伦",
      "summary": "晁盖等上梁山，王伦嫉贤，林冲火并，众推晁盖为寨主。",
      "function": "换寨主",
      "emotion": "快",
      "beats": 4
    },
    {
      "chapter": 10,
      "title": "宋江杀惜",
      "summary": "宋江私放晁盖，阎婆惜拾书要挟，宋江怒杀之，投柴进庄避难。",
      "function": "引宋江",
      "emotion": "迫",
      "beats": 4
    }
  ],
