{
  "id": "ink",
  "name": "纸墨 · 出版排版",
  "description": "暖白纸感，墨褐强调，版心收紧",
  "tokens": {
    "--bg": "#fbfaf7",
    "--soft": "#f5f2ec",
    "--warm": "#f7f3ea",
    "--ink": "#1c1a17",
    "--ink-2": "#3a362f",
    "--muted": "#6b6558",
    "--meta": "#a09884",
    "--line": "#e2dcd0",
    "--hair": "#efeae0",
    "--accent": "#7a5c2e",
    "--accent-hover": "#64491f",
    "--accent-active": "#4f3a17",
    "--accent-soft": "#f3ecdd",
    "--ok": "#4a6741",
    "--danger": "#a03d2a",
    "--radius": "6px",
    "--radius-md": "8px",
    "--radius-lg": "12px",
    "--pill": "999px",
