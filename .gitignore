# ── 依赖 ──
node_modules/

# ── 运行产物（daemon/测试自产，不入版本控制）──
*.log
.cache/
tmp/
*.tmp

# ── 工具运行时数据（不属仓资产；私人副本已归档到仓外）──
.ua/
.zcode/

# 库内运行数据（本仓不含任何库；以下防误放）
.openstory/
.history/
.pinax/

# OS-160：样例库自带的运行态配置是例外——真实路径生成（tools/samples/generate-sample-config.mjs）
# 后入库，让「打开样例库＝复现一份配置好的工作台」。其余隐藏数据继续挡。
!samples/**/.openstory/
!samples/**/.openstory/project.json
!samples/**/.openstory/ui-state.json
!samples/**/.openstory/plugins/
!samples/**/.openstory/plugins/suite-state.json

# ── 本机环境 ──
.env
.env.*
!.env.example

# ── 系统杂项 ──
.DS_Store
Thumbs.db
desktop.ini

# ── Understand-Anything 知识图谱（图谱本体入库，运行产物不入）──
.ua/intermediate/
.ua/tmp/
.ua/diff-overlay.json
.ua/.trash-*/

# ── 运行残留补遗（OS-110 发现）──
samples/**/.operations.jsonl

# ── Python 运行时缓存（knowledge-runtime worker/installer 自产）──
__pycache__/
*.pyc

# 样例库里的 .history 是运行备份，不是内容（样例只留稿件与 OS-160 运行态配置）
samples/**/.history/
samples/**/*/.history/
samples/**/*/*/.history/
