{
  "spec": "openstory-module@2",
  "id": "deduce",
  "name": "推演引擎",
  "version": "0.1.0",
  "builtin": true,
  "description": "内置内核件：确定性 2d6、局面卡与候选生成通过 deduce.engine@1 供扮演工作台消费；不占端点或页签，启停由能力图与活跃消费者推导。",
  "class": "kernel",
  "entry": "index.mjs",
  "requires": [
    { "id": "base.naming", "min": 1 },
    { "id": "fact.store", "min": 3 },
    { "id": "fact.pack", "min": 1 }
  ],
  "capabilities": [
    {
      "id": "deduce.engine",
      "version": 1,
      "golden": "deduce-engine-v1"
    }
  ],
  "endpoints": []
}
