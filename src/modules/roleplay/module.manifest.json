    "roleplayTurn",
    "deduceExport",
    "deducePromote",
    "deducePendingSettle",
    "deduceSessionsGet",
    "deduceSessionManage",
    "deduceBranch",
    "deduceAssets",
    "deduceAssetFile"
  ],
  "pages": [
    {
      "id": "deduce",
      "label": "扮演"
    }
  ],
  "settings": [],
  "class": "workbench",
  "entry": "index.mjs",
  "requires": [
    { "id": "deduce.engine", "min": 1 },
    { "id": "fact.store", "min": 3 },
    { "id": "prose.write", "min": 1 },
    { "id": "text.analyze", "min": 1 }
  ],
  "slots": [
    {
      "slot": "tab",
      "page": "deduce"
    }
  ],
  "settingsHint": "会话状态落库内「扮演/」，模型与运行时在「设置 · 引擎与存储」里配；停用保留全部会话与素材。"
