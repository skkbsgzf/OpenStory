{
  "schemaVersion": "openstory-runtime-kit@1",
  "id": "cli-qoder",
  "name": "Qoder CLI",
  "kind": "cli",
  "category": "cli",
  "description": "把 Qoder CLI 当一次性模型用（嫁接：每次对话跑一次子进程）。装没装由 probe 探测。",
  "probe": { "cmd": "qoder", "args": ["--version"] },
  "cliArgs": ["-p", "{prompt}"],
  "timeoutMs": 180000
}
