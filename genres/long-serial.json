{
  "schemaVersion": "openstory-genre@1",
  "id": "long-serial",
  "name": "长篇连载",
  "tier": "primary",
  "summary": "按章连载：章末钩、伏笔台账、连续性核对，世界书与 wiki 是刚需。",
  "deliverables": ["novel"],
  "requiredCarriers": ["pinax.carrier.novel", "pinax.carrier.outline", "pinax.carrier.worldbook"],
  "optionalCarriers": ["pinax.carrier.notes", "pinax.carrier.dossier"],
  "excludedPages": [],
  "length": { "unit": "chars", "total": { "min": 200000, "target": 800000, "max": 3000000 }, "perUnit": { "min": 2000, "target": 3000, "max": 4000 }, "divideBy": "chapter" },
  "structure": { "numbering": "NNN-标题", "chapterHook": true },
  "agentPolicy": {
    "pacing": "按章推进：每章一个核心事件＋一个转折，章末留钩子；伏笔要能回收。",
    "openHook": "每章前 300 字内有推进或冲突；禁止整章回顾。",
    "reviewFocus": ["章末钩子是否成立", "伏笔是否有台账", "人物动机是否连贯", "设定是否与既有事实冲突"],
    "forbidden": ["章节回顾式开篇", "无推进的日常流水", "凭空新增设定"]
  },
  "knowledgePacks": ["worldbook/continuity", "trope/cultivation-ladder"],
  "compatStyles": ["*"]
}
