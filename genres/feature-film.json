{
  "schemaVersion": "openstory-genre@1",
  "id": "feature-film",
  "name": "院线电影",
  "tier": "extended",
  "summary": "三幕结构、场景目标-障碍-转折；90–120 分钟体量。",
  "deliverables": ["script"],
  "requiredCarriers": ["openstory.carrier.script", "openstory.carrier.outline"],
  "optionalCarriers": ["openstory.carrier.worldbook"],
  "excludedPages": ["wiki"],
  "length": { "unit": "minutes", "total": { "min": 90, "target": 110, "max": 130 }, "perUnit": { "min": 1, "target": 3, "max": 6 }, "divideBy": "scene" },
  "structure": { "numbering": "场 001", "chapterHook": false },
  "agentPolicy": {
    "pacing": "三幕结构：建置 25%、对抗 50%、结局 25%；每场都要有目标、障碍、转折。",
    "openHook": "开场十分钟内建立主角、世界与核心张力。",
    "reviewFocus": ["三幕比例", "每场是否推动剧情", "人物弧是否闭合"],
    "forbidden": ["电视剧式拖沓", "无转折的场景", "旁白解说"]
  },
  "knowledgePacks": ["plot/save-the-cat"],
  "compatStyles": ["*"]
}
